# Backend
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_JWT_SECRET=
CORS_ORIGINS=
# Optional: pin the churn model file's SHA-256 (from app/ml/artifacts/churn_model.json) in production
CHURN_MODEL_SHA256=
# Who may sign in (comma-separated Google addresses; domains optional). Empty = nobody.
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
# Service key for POST /events (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
INGEST_API_KEY=
# Frontend
API_BASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=
APP_BASE_URL=http://localhost:8501
# Optional. Minutes of inactivity before sign-out (default 30; 0 = never)
# IDLE_TIMEOUT_MINUTES=30
# Optional. Seconds to keep retrying a sleeping API before showing "unavailable" (default 0 = fail
# fast; set about 45 when the API is on a free host that sleeps, such as Render)
# API_WAKE_SECONDS=45

# Local Postgres from docker-compose.yml (tests create and use their own churnscope_test database)
# DATABASE_URL=postgresql+psycopg://churnscope:churnscope@localhost:5433/churnscope
# TEST_DATABASE_URL=postgresql+psycopg://churnscope:churnscope@localhost:5433/churnscope_test   (separate DB: tests drop its schema)
